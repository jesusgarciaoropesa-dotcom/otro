---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { categorias, getCategoriaImagen } from '../data/categorias';
import { withBase } from '../lib/url';
import { getCollection } from 'astro:content';

const articulos = await getCollection('articulos');
const pilares = articulos.filter((a) => a.data.pilar);
const recientes = [...articulos]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<BaseLayout
  title="Huerto urbano en balcón y terraza: guías, riego automático y cultivo vertical"
  description="Aprende a cultivar tu propio huerto en un balcón o terraza pequeña: riego automático, cultivo vertical, qué plantar cada mes y las mejores herramientas."
>
  <section
    class="relative left-1/2 w-screen -translate-x-1/2 overflow-hidden bg-cover bg-bottom"
    style={`background-image: url('${withBase('/images/hero-huerto.svg')}')`}
  >
    <div class="mx-auto max-w-5xl px-4 py-16 sm:py-24">
      <div class="max-w-xl rounded-2xl bg-(--color-crema)/90 px-6 py-8 shadow-xl ring-1 ring-black/5 backdrop-blur-sm sm:px-10 sm:py-10">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-(--color-hoja)/15 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-(--color-hoja-oscuro)">
          🌱 Guías para huertos urbanos
        </span>
        <h1 class="mt-4 font-(--font-display) text-3xl font-semibold leading-tight text-(--color-hoja-oscuro) sm:text-5xl">
          Cultiva tu propio huerto aunque solo tengas un balcón
        </h1>
        <p class="mt-4 max-w-md text-stone-700">
          Guías prácticas de riego automático, cultivo vertical y calendario de siembra
          pensadas para pisos y terrazas pequeñas, sin necesidad de jardín.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#guias" class="btn-primary">Ver guías principales</a>
          <a href="#categorias" class="btn-secondary">Explorar categorías</a>
        </div>
        <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-2 border-t border-stone-300/60 pt-5 text-sm text-stone-600">
          <div>
            <dt class="sr-only">Categorías</dt>
            <dd>
              <span class="counter font-(--font-display) text-lg font-semibold text-(--color-tierra)" data-count-to="9">0</span>
              categorías
            </dd>
          </div>
          <div>
            <dt class="sr-only">Guías</dt>
            <dd>
              <span class="counter font-(--font-display) text-lg font-semibold text-(--color-tierra)" data-count-to="80" data-suffix="+">0</span>
              guías prácticas
            </dd>
          </div>
          <div>
            <dt class="sr-only">Actualización</dt>
            <dd>Contenido <span class="font-semibold text-stone-800">actualizado cada temporada</span></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  {pilares.length > 0 && (
    <section id="guias" class="mt-20 scroll-mt-24">
      <div class="flex items-baseline justify-between gap-4">
        <div>
          <span class="text-xs font-semibold uppercase tracking-widest text-(--color-tierra)">Empieza por aquí</span>
          <h2 class="mt-1 font-(--font-display) text-2xl font-semibold text-(--color-hoja-oscuro) sm:text-3xl">Guías principales</h2>
        </div>
      </div>
      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        {pilares.map((a, i) => (
          <a
            href={withBase(`/articulos/${a.id}/`)}
            class="reveal group overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-black/5 transition hover:-translate-y-1 hover:shadow-2xl"
            style={`transition-delay: ${i * 160}ms`}
          >
            <div class="relative h-40 overflow-hidden">
              <img
                src={withBase(getCategoriaImagen(a.data.categoria))}
                alt=""
                loading="lazy"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent" />
              <h3 class="absolute inset-x-4 bottom-3 font-(--font-display) text-lg font-semibold text-white drop-shadow-sm">
                {a.data.title}
              </h3>
            </div>
            <p class="p-5 text-sm text-stone-600">{a.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <AdSlot adId="home-mid" label="Publicidad" />

  <section id="categorias" class="mt-20 scroll-mt-24">
    <span class="text-xs font-semibold uppercase tracking-widest text-(--color-tierra)">El mapa del sitio</span>
    <h2 class="mt-1 font-(--font-display) text-2xl font-semibold text-(--color-hoja-oscuro) sm:text-3xl">Explora por categoría</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {categorias.map((cat, i) => (
        <a
          href={withBase(`/categorias/${cat.slug}/`)}
          class="reveal group overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-black/5 transition hover:-translate-y-1 hover:shadow-2xl"
          style={`transition-delay: ${(i % 3) * 160}ms`}
        >
          <div class="relative h-32 overflow-hidden">
            <img
              src={withBase(getCategoriaImagen(cat.slug))}
              alt=""
              loading="lazy"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
            <h3 class="absolute inset-x-4 bottom-3 font-(--font-display) text-lg font-semibold text-white drop-shadow-sm">
              {cat.nombre}
            </h3>
          </div>
          <p class="p-5 text-sm text-stone-600">{cat.descripcion}</p>
        </a>
      ))}
    </div>
  </section>

  {recientes.length > 0 && (
    <section class="relative left-1/2 mt-20 w-screen -translate-x-1/2 bg-white py-16">
      <div class="mx-auto max-w-5xl px-4">
        <span class="text-xs font-semibold uppercase tracking-widest text-(--color-tierra)">Recién publicado</span>
        <h2 class="mt-1 font-(--font-display) text-2xl font-semibold text-(--color-hoja-oscuro) sm:text-3xl">Últimos artículos</h2>
        <ul class="mt-6 divide-y divide-stone-200 overflow-hidden rounded-2xl ring-1 ring-stone-200">
          {recientes.map((a, i) => (
            <li class="reveal" style={`transition-delay: ${i * 120}ms`}>
              <a href={withBase(`/articulos/${a.id}/`)} class="flex items-center gap-4 px-5 py-4 transition hover:bg-(--color-crema)">
                <img
                  src={withBase(getCategoriaImagen(a.data.categoria))}
                  alt=""
                  loading="lazy"
                  class="h-14 w-20 shrink-0 rounded-lg object-cover shadow-sm"
                />
                <span class="flex-1 font-medium text-stone-800">{a.data.title}</span>
                <span class="whitespace-nowrap text-xs text-stone-400">
                  {a.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <script>
    // Cuenta de 0 al valor final cada .counter del hero, salvo que el usuario
    // prefiera menos movimiento (en cuyo caso se muestra el valor final ya).
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('.counter').forEach((el) => {
      const target = Number(el.dataset.countTo ?? '0');
      const suffix = el.dataset.suffix ?? '';

      if (reduceMotion) {
        el.textContent = `${target}${suffix}`;
        return;
      }

      const duration = 2000;
      const start = performance.now();

      function tick(now: number) {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = `${Math.round(eased * target)}${suffix}`;
        if (progress < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    });
  </script>
</BaseLayout>
