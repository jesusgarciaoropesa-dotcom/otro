---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { categorias } from '../data/categorias';
import { getCollection } from 'astro:content';

const articulos = await getCollection('articulos');
const pilares = articulos.filter((a) => a.data.pilar);
const recientes = [...articulos]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<BaseLayout
  title="Huerto urbano en balcón y terraza: guías, riego automático y cultivo vertical"
  description="Aprende a cultivar tu propio huerto en un balcón o terraza pequeña: riego automático, cultivo vertical, qué plantar cada mes y las mejores herramientas."
>
  <section class="rounded-2xl bg-[--color-hoja]/10 px-6 py-12 text-center">
    <h1 class="text-3xl font-bold text-[--color-hoja-oscuro] sm:text-4xl">
      Cultiva tu propio huerto aunque solo tengas un balcón
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-stone-600">
      Guías prácticas de riego automático, cultivo vertical y calendario de siembra
      pensadas para pisos y terrazas pequeñas, sin necesidad de jardín.
    </p>
  </section>

  {pilares.length > 0 && (
    <section class="mt-12">
      <h2 class="text-xl font-bold text-stone-900">Guías principales</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {pilares.map((a) => (
          <a
            href={`/articulos/${a.id}/`}
            class="rounded-xl border border-stone-200 bg-white p-5 transition hover:border-[--color-hoja] hover:shadow-sm"
          >
            <h3 class="font-semibold text-stone-900">{a.data.title}</h3>
            <p class="mt-2 text-sm text-stone-600">{a.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <AdSlot adId="home-mid" label="Publicidad" />

  <section class="mt-12">
    <h2 class="text-xl font-bold text-stone-900">Explora por categoría</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {categorias.map((cat) => (
        <a
          href={`/categorias/${cat.slug}/`}
          class="rounded-xl border border-stone-200 bg-white p-5 transition hover:border-[--color-hoja] hover:shadow-sm"
        >
          <span class="text-2xl">{cat.emoji}</span>
          <h3 class="mt-2 font-semibold text-stone-900">{cat.nombre}</h3>
          <p class="mt-1 text-sm text-stone-600">{cat.descripcion}</p>
        </a>
      ))}
    </div>
  </section>

  {recientes.length > 0 && (
    <section class="mt-12">
      <h2 class="text-xl font-bold text-stone-900">Últimos artículos</h2>
      <ul class="mt-4 divide-y divide-stone-200 rounded-xl border border-stone-200 bg-white">
        {recientes.map((a) => (
          <li>
            <a href={`/articulos/${a.id}/`} class="flex items-center justify-between gap-4 px-5 py-4 hover:bg-stone-50">
              <span class="font-medium text-stone-800">{a.data.title}</span>
              <span class="whitespace-nowrap text-xs text-stone-400">
                {a.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
