---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { categorias, getCategoriaImagen } from '../data/categorias';
import { withBase } from '../lib/url';
import { getCollection } from 'astro:content';

const articulos = await getCollection('articulos');
const pilares = articulos.filter((a) => a.data.pilar);
const recientes = [...articulos]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<BaseLayout
  title="Huerto urbano en balcón y terraza: guías, riego automático y cultivo vertical"
  description="Aprende a cultivar tu propio huerto en un balcón o terraza pequeña: riego automático, cultivo vertical, qué plantar cada mes y las mejores herramientas."
>
  <section
    class="relative flex min-h-[420px] items-start justify-center overflow-hidden rounded-2xl bg-cover bg-bottom px-6 pt-12 text-center sm:min-h-[460px] sm:pt-16"
    style={`background-image: url('${withBase('/images/hero-huerto.svg')}')`}
  >
    <div class="relative rounded-2xl bg-[--color-crema]/85 px-6 py-8 shadow-sm backdrop-blur-sm sm:px-10">
      <h1 class="font-[--font-display] text-3xl font-semibold text-[--color-hoja-oscuro] sm:text-5xl">
        Cultiva tu propio huerto aunque solo tengas un balcón
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-stone-700">
        Guías prácticas de riego automático, cultivo vertical y calendario de siembra
        pensadas para pisos y terrazas pequeñas, sin necesidad de jardín.
      </p>
    </div>
  </section>

  {pilares.length > 0 && (
    <section class="mt-16">
      <h2 class="font-[--font-display] text-2xl font-semibold text-[--color-hoja-oscuro]">Guías principales</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-3">
        {pilares.map((a) => (
          <a
            href={withBase(`/articulos/${a.id}/`)}
            class="overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:border-[--color-tierra] hover:shadow-lg"
          >
            <img
              src={withBase(getCategoriaImagen(a.data.categoria))}
              alt=""
              loading="lazy"
              class="h-32 w-full object-cover"
            />
            <div class="p-5">
              <h3 class="font-semibold text-stone-900">{a.data.title}</h3>
              <p class="mt-2 text-sm text-stone-600">{a.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <AdSlot adId="home-mid" label="Publicidad" />

  <section class="mt-16">
    <h2 class="font-[--font-display] text-2xl font-semibold text-[--color-hoja-oscuro]">Explora por categoría</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {categorias.map((cat) => (
        <a
          href={withBase(`/categorias/${cat.slug}/`)}
          class="overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:border-[--color-tierra] hover:shadow-lg"
        >
          <img src={withBase(getCategoriaImagen(cat.slug))} alt="" loading="lazy" class="h-28 w-full object-cover" />
          <div class="p-5">
            <h3 class="font-semibold text-stone-900">{cat.nombre}</h3>
            <p class="mt-1 text-sm text-stone-600">{cat.descripcion}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  {recientes.length > 0 && (
    <section class="mt-16">
      <h2 class="font-[--font-display] text-2xl font-semibold text-[--color-hoja-oscuro]">Últimos artículos</h2>
      <ul class="mt-6 divide-y divide-stone-200 overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm">
        {recientes.map((a) => (
          <li>
            <a href={withBase(`/articulos/${a.id}/`)} class="flex items-center gap-4 px-5 py-3 transition hover:bg-[--color-crema]">
              <img
                src={withBase(getCategoriaImagen(a.data.categoria))}
                alt=""
                loading="lazy"
                class="h-12 w-16 shrink-0 rounded-lg object-cover"
              />
              <span class="flex-1 font-medium text-stone-800">{a.data.title}</span>
              <span class="whitespace-nowrap text-xs text-stone-400">
                {a.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
