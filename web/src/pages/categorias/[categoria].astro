---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { categorias, getCategoria, getCategoriaImagen } from '../../data/categorias';
import { withBase } from '../../lib/url';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return categorias.map((cat) => ({ params: { categoria: cat.slug } }));
}

const { categoria } = Astro.params;
const cat = getCategoria(categoria)!;

const todos = await getCollection('articulos');
const articulos = todos
  .filter((a) => a.data.categoria === categoria)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={cat.nombre} description={cat.descripcion}>
  <nav class="mb-4 text-sm text-stone-500" aria-label="breadcrumb">
    <a href={withBase('/')} class="hover:underline">Inicio</a>
    <span class="mx-1">/</span>
    <span class="text-stone-700">{cat.nombre}</span>
  </nav>

  <header class="overflow-hidden rounded-2xl border border-stone-200 bg-white">
    <img src={withBase(getCategoriaImagen(cat.slug))} alt="" class="h-40 w-full object-cover sm:h-52" />
    <div class="p-6">
      <h1 class="font-[--font-display] text-3xl font-semibold text-[--color-hoja-oscuro]">
        {cat.nombre}
      </h1>
      <p class="mt-2 max-w-2xl text-stone-600">{cat.descripcion}</p>
    </div>
  </header>

  <AdSlot adId={`categoria-${cat.slug}-top`} label="Publicidad" />

  {articulos.length === 0 ? (
    <p class="mt-8 text-stone-500">Próximamente publicaremos artículos en esta categoría.</p>
  ) : (
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {articulos.map((a) => (
        <li>
          <a
            href={withBase(`/articulos/${a.id}/`)}
            class="flex h-full gap-4 rounded-xl border border-stone-200 bg-white p-3 transition hover:border-[--color-tierra] hover:shadow-sm"
          >
            <img
              src={withBase(getCategoriaImagen(cat.slug))}
              alt=""
              loading="lazy"
              class="h-20 w-24 shrink-0 rounded-lg object-cover"
            />
            <div>
              <h2 class="font-semibold text-stone-900">{a.data.title}</h2>
              <p class="mt-1 text-sm text-stone-600">{a.data.description}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
