---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { categorias, getCategoria, getCategoriaImagen } from '../../data/categorias';
import { withBase } from '../../lib/url';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return categorias.map((cat) => ({ params: { categoria: cat.slug } }));
}

const { categoria } = Astro.params;
const cat = getCategoria(categoria)!;

const todos = await getCollection('articulos');
const articulos = todos
  .filter((a) => a.data.categoria === categoria)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pilar = articulos.find((a) => a.data.pilar);
const resto = articulos.filter((a) => a !== pilar);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(withBase('/'), Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: cat.nombre, item: new URL(withBase(`/categorias/${cat.slug}/`), Astro.site).toString() },
  ],
};

const etiquetaIntencion: Record<string, string> = {
  comparativa: 'Comparativa',
  transaccional: 'Guía de compra',
};
---

<BaseLayout title={cat.nombre} description={cat.descripcion}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} slot="head" />
  <nav class="mb-4 text-sm text-stone-600" aria-label="breadcrumb">
    <a href={withBase('/')} class="hover:underline">Inicio</a>
    <span class="mx-1">/</span>
    <span class="text-stone-700">{cat.nombre}</span>
  </nav>

  <header class="relative left-1/2 w-screen -translate-x-1/2 overflow-hidden">
    <div class="relative h-56 sm:h-64">
      <img
        src={withBase(getCategoriaImagen(cat.slug))}
        alt=""
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent" />
      <div class="absolute inset-x-0 bottom-0">
        <div class="mx-auto max-w-5xl px-4 pb-6">
          <h1 class="font-(--font-display) text-3xl font-semibold text-white drop-shadow-sm sm:text-4xl">
            {cat.nombre}
          </h1>
          <p class="mt-2 max-w-2xl text-white/90">{cat.descripcion}</p>
          {articulos.length > 0 && (
            <p class="mt-2 text-sm font-semibold text-(--color-mostaza)">
              {articulos.length} {articulos.length === 1 ? 'guía práctica' : 'guías prácticas'}
            </p>
          )}
        </div>
      </div>
    </div>
  </header>

  <div class="mt-10">
    <AdSlot adId={`categoria-${cat.slug}-top`} label="Publicidad" />
  </div>

  {articulos.length === 0 ? (
    <p class="mt-8 text-stone-600">Próximamente publicaremos artículos en esta categoría.</p>
  ) : (
    <>
      {pilar && (
        <a
          href={withBase(`/articulos/${pilar.id}/`)}
          class="reveal group mt-4 flex flex-col overflow-hidden rounded-2xl bg-(--color-hoja-oscuro) shadow-lg ring-1 ring-black/5 transition hover:-translate-y-1 hover:shadow-2xl sm:flex-row"
        >
          <div class="relative h-48 shrink-0 overflow-hidden sm:h-auto sm:w-2/5">
            <img
              src={withBase(getCategoriaImagen(cat.slug))}
              alt=""
              loading="lazy"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />
          </div>
          <div class="flex flex-col justify-center p-6 sm:p-8">
            <span class="inline-block w-fit rounded-full bg-(--color-mostaza) px-3 py-1 text-xs font-semibold text-(--color-hoja-oscuro)">
              ★ Guía principal
            </span>
            <h2 class="mt-3 font-(--font-display) text-xl font-semibold text-white sm:text-2xl">
              {pilar.data.title}
            </h2>
            <p class="mt-2 text-sm text-(--color-crema)/85">{pilar.data.description}</p>
            <span class="mt-4 text-sm font-semibold text-(--color-mostaza) group-hover:underline">
              Leer la guía completa →
            </span>
          </div>
        </a>
      )}

      <ul class="mt-8 grid gap-6 sm:grid-cols-2">
        {resto.map((a, i) => (
          <li class="reveal" style={`transition-delay: ${(i % 4) * 90}ms`}>
            <a
              href={withBase(`/articulos/${a.id}/`)}
              class="flex h-full gap-4 rounded-2xl bg-white p-4 shadow-md ring-1 ring-black/5 transition hover:-translate-y-1 hover:shadow-xl"
            >
              <img
                src={withBase(getCategoriaImagen(cat.slug))}
                alt=""
                loading="lazy"
                class="h-20 w-24 shrink-0 rounded-xl object-cover"
              />
              <div class="flex flex-col">
                <h2 class="font-semibold text-stone-900">{a.data.title}</h2>
                <p class="mt-1 text-sm text-stone-600">{a.data.description}</p>
                <p class="mt-auto flex items-center gap-2 pt-2 text-xs text-stone-600">
                  {etiquetaIntencion[a.data.intencion] && (
                    <span class="rounded-full bg-(--color-crema-oscuro) px-2 py-0.5 font-semibold text-(--color-tierra-oscuro)">
                      {etiquetaIntencion[a.data.intencion]}
                    </span>
                  )}
                  <time datetime={a.data.pubDate.toISOString()}>
                    {a.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </time>
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </>
  )}
</BaseLayout>
