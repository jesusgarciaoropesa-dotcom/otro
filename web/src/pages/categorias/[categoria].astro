---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { categorias, getCategoria } from '../../data/categorias';
import { withBase } from '../../lib/url';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return categorias.map((cat) => ({ params: { categoria: cat.slug } }));
}

const { categoria } = Astro.params;
const cat = getCategoria(categoria)!;

const todos = await getCollection('articulos');
const articulos = todos
  .filter((a) => a.data.categoria === categoria)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={cat.nombre} description={cat.descripcion}>
  <nav class="mb-4 text-sm text-stone-500" aria-label="breadcrumb">
    <a href={withBase('/')} class="hover:underline">Inicio</a>
    <span class="mx-1">/</span>
    <span class="text-stone-700">{cat.nombre}</span>
  </nav>

  <header>
    <h1 class="text-3xl font-bold text-stone-900">
      <span aria-hidden="true">{cat.emoji}</span> {cat.nombre}
    </h1>
    <p class="mt-2 max-w-2xl text-stone-600">{cat.descripcion}</p>
  </header>

  <AdSlot adId={`categoria-${cat.slug}-top`} label="Publicidad" />

  {articulos.length === 0 ? (
    <p class="mt-8 text-stone-500">Próximamente publicaremos artículos en esta categoría.</p>
  ) : (
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {articulos.map((a) => (
        <li>
          <a
            href={withBase(`/articulos/${a.id}/`)}
            class="block h-full rounded-xl border border-stone-200 bg-white p-5 transition hover:border-[--color-hoja] hover:shadow-sm"
          >
            <h2 class="font-semibold text-stone-900">{a.data.title}</h2>
            <p class="mt-2 text-sm text-stone-600">{a.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
