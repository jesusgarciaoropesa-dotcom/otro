---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout
  title="Buscar"
  description="Busca entre todos los artículos de MiHuertoUrbano: guías de cultivo, riego, plagas, compostaje y comparativas de productos."
>
  <Fragment slot="head">
    <link href={withBase('/pagefind/pagefind-ui.css')} rel="stylesheet" />
    <style>
      #search {
        --pagefind-ui-primary: var(--color-tierra);
        --pagefind-ui-text: #44403c;
        --pagefind-ui-background: #fff;
        --pagefind-ui-border: #e7e5e4;
        --pagefind-ui-border-width: 1px;
        --pagefind-ui-border-radius: 1rem;
        --pagefind-ui-font: var(--font-sans, inherit);
      }
    </style>
  </Fragment>

  <h1 class="font-(--font-display) text-3xl font-semibold text-(--color-hoja-oscuro) sm:text-4xl">
    Buscar en la web
  </h1>
  <p class="mt-3 max-w-2xl text-stone-600">
    Escribe lo que necesites (una planta, una plaga, un producto...) y busca entre todos los
    artículos de MiHuertoUrbano.
  </p>

  <div id="search" class="mt-8"></div>

  <script is:inline src={withBase('/pagefind/pagefind-ui.js')}></script>
  <script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
    window.addEventListener('DOMContentLoaded', () => {
      const ui = new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        bundlePath: base.replace(/\/$/, '') + '/pagefind/',
        translations: {
          placeholder: 'Busca una planta, una plaga, un producto...',
          zero_results: 'No hemos encontrado nada para "[SEARCH_TERM]".',
          many_results: '[COUNT] resultados para "[SEARCH_TERM]"',
          one_result: '1 resultado para "[SEARCH_TERM]"',
          alt_search: 'No hay resultados para "[SEARCH_TERM]". Mostrando resultados para "[DIFFERENT_TERM]" en su lugar.',
          search_suggestion: 'No hay resultados para "[SEARCH_TERM]". Prueba con alguno de estos términos:',
          searching: 'Buscando "[SEARCH_TERM]"...',
        },
      });

      // Si se llega con ?q=... (p. ej. desde el cuadro de búsqueda de Google),
      // rellenamos el input y lanzamos la búsqueda automáticamente. Esto hace
      // que la SearchAction declarada en el JSON-LD de la home sea real.
      const q = new URLSearchParams(window.location.search).get('q');
      if (q) {
        const rellenar = () => {
          const input = document.querySelector('#search input.pagefind-ui__search-input');
          if (!input) return false;
          input.value = q;
          input.dispatchEvent(new Event('input', { bubbles: true }));
          return true;
        };
        // El input lo crea Pagefind de forma asíncrona: reintenta unas veces.
        let intentos = 0;
        const t = setInterval(() => {
          if (rellenar() || ++intentos > 40) clearInterval(t);
        }, 50);
      }
    });
  </script>
</BaseLayout>
