---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import { cultivos, meses } from '../data/calculadora-cultivos';

// Mes actual por defecto (para que el usuario vea resultados al entrar).
const mesActual = new Date().getMonth() + 1;

const tipoEtiqueta: Record<string, string> = {
  hortaliza: 'Hortaliza',
  hoja: 'Hoja',
  raiz: 'Raíz',
  aromatica: 'Aromática',
  fruta: 'Fruta',
};

// Familias con más de un cultivo: para avisar de "no juntar misma familia".
const conteoFamilias: Record<string, number> = {};
for (const c of cultivos) conteoFamilias[c.familia] = (conteoFamilias[c.familia] || 0) + 1;

// Datos que pasamos al script de cliente, con la URL y las etiquetas ya resueltas.
const datos = cultivos.map((c) => ({
  nombre: c.nombre,
  luz: c.luz,
  meses: c.meses,
  nota: c.nota,
  tipo: c.tipo,
  tipoLabel: tipoEtiqueta[c.tipo],
  familia: c.familia,
  facil: c.facil,
  dias: c.dias ?? null,
  buenas: c.buenas ?? [],
  evitaMisma: conteoFamilias[c.familia] > 1,
  url: withBase(`/articulos/${c.slug}/`),
}));

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(withBase('/'), Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Qué plantar en tu balcón', item: new URL(withBase('/que-plantar-en-tu-balcon/'), Astro.site).toString() },
  ],
};

const tipos = [
  { val: 'todos', label: 'Todos' },
  { val: 'hortaliza', label: 'Hortalizas' },
  { val: 'hoja', label: 'Hojas' },
  { val: 'raiz', label: 'Raíces' },
  { val: 'aromatica', label: 'Aromáticas' },
  { val: 'fruta', label: 'Frutas' },
];

const faq = [
  {
    pregunta: '¿Cómo sé cuánta luz recibe mi balcón?',
    respuesta:
      'Fíjate en la orientación y en las horas de sol directo que le da a la zona donde pondrías las macetas. Un balcón al sur suele recibir mucho sol (6 horas o más); al este o al oeste, sol de media jornada (media sombra); y al norte, poca o nada de luz directa (sombra). Observa un día despejado a distintas horas: lo que cuenta es el sol directo sobre las macetas, no la claridad general.',
  },
  {
    pregunta: '¿Puedo tener huerto en un balcón sin sol directo?',
    respuesta:
      'Sí. En sombra o media sombra van bien las hortalizas de hoja (lechuga, espinaca, acelga, canónigos), muchas aromáticas (perejil, cilantro, menta, cebollino) y los rabanitos. Lo que necesita mucho sol son las hortalizas de fruto (tomate, pimiento, berenjena) y la mayoría de frutales. Filtra por tu nivel de luz y la calculadora te muestra solo lo que prospera.',
  },
  {
    pregunta: '¿Por qué el mes cambia lo que puedo plantar?',
    respuesta:
      'Cada cultivo tiene su época de siembra según la temperatura. En primavera y verano se siembran los de calor (tomate, calabacín, albahaca); en otoño e invierno, los de frío (habas, ajos, espinacas, guisantes). Por eso la calculadora te pide el mes: así solo te propone lo que tiene sentido sembrar ahora, no en teoría.',
  },
  {
    pregunta: '¿Qué significa la compatibilidad entre cultivos?',
    respuesta:
      'Algunas plantas se ayudan cuando comparten maceta o van cerca (mejoran el sabor, ahuyentan plagas o aprovechan mejor el espacio) y otras conviene separarlas, sobre todo las de la misma familia, porque agotan los mismos nutrientes y comparten plagas. En cada resultado te indicamos con qué se lleva bien y qué evitar.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
  })),
};
---

<BaseLayout
  title="Qué plantar en tu balcón: calculadora"
  description="Calculadora para saber qué cultivar en tu balcón según las horas de sol y el mes. Filtra por tipo, dificultad y rapidez, y descubre qué plantas se llevan bien entre sí."
>
  <script type="application/ld+json" set:html={JSON.stringify([breadcrumbLd, faqLd])} slot="head" />

  <nav class="mb-4 text-sm text-stone-600" aria-label="breadcrumb">
    <a href={withBase('/')} class="hover:underline">Inicio</a>
    <span class="mx-1">/</span>
    <span class="text-stone-700">Qué plantar en tu balcón</span>
  </nav>

  <header class="mb-8">
    <h1 class="font-(--font-display) text-3xl font-semibold text-(--color-hoja-oscuro) sm:text-4xl">
      ¿Qué puedes plantar en tu balcón?
    </h1>
    <p class="mt-3 max-w-2xl text-stone-600">
      Dinos cuánta luz recibe tu balcón y en qué mes estás, y te decimos qué cultivos puedes
      plantar ahora mismo. Filtra por tipo, dificultad o rapidez, y mira con qué se lleva bien
      cada planta. Cada resultado enlaza con su guía completa.
    </p>
  </header>

  <div class="grid gap-6 rounded-2xl bg-white p-5 shadow-md ring-1 ring-black/5 sm:grid-cols-2 sm:p-6">
    <fieldset>
      <legend class="mb-3 text-sm font-semibold uppercase tracking-wide text-stone-500">
        ¿Cuánta luz tiene tu balcón?
      </legend>
      <div class="flex flex-col gap-2" role="radiogroup" id="luz-group">
        <button type="button" data-luz="3" class="luz-btn rounded-xl border border-stone-200 px-4 py-3 text-left text-sm transition hover:border-(--color-hoja)" aria-pressed="false">
          <span class="font-semibold text-stone-900">☀️ Mucho sol</span>
          <span class="block text-stone-500">6 horas o más de sol directo</span>
        </button>
        <button type="button" data-luz="2" class="luz-btn rounded-xl border border-stone-200 px-4 py-3 text-left text-sm transition hover:border-(--color-hoja)" aria-pressed="false">
          <span class="font-semibold text-stone-900">⛅ Media sombra</span>
          <span class="block text-stone-500">Sol de media jornada (3-5 h)</span>
        </button>
        <button type="button" data-luz="1" class="luz-btn rounded-xl border border-stone-200 px-4 py-3 text-left text-sm transition hover:border-(--color-hoja)" aria-pressed="false">
          <span class="font-semibold text-stone-900">🌥️ Sombra</span>
          <span class="block text-stone-500">Poca luz directa (balcón norte)</span>
        </button>
      </div>
      <p class="mt-2 text-xs text-stone-500">
        ¿No lo sabes? Mira <a href={withBase('/articulos/cuantas-horas-sol-tiene-tu-balcon/')} class="text-(--color-tierra) hover:underline">cómo medir las horas de sol de tu balcón</a>.
      </p>
    </fieldset>

    <fieldset>
      <legend class="mb-3 text-sm font-semibold uppercase tracking-wide text-stone-500">
        ¿En qué mes estás?
      </legend>
      <select id="mes-select" class="w-full rounded-xl border border-stone-200 bg-white px-4 py-3 text-sm">
        <option value="0">Cualquier mes</option>
        {meses.map((m, i) => (
          <option value={i + 1} selected={i + 1 === mesActual}>{m}</option>
        ))}
      </select>
      <p class="mt-2 text-xs text-stone-500">
        Meses de siembra o plantación para clima mediterráneo; ajusta 2-3 semanas según tu zona.
      </p>

      <fieldset class="mt-5">
        <legend class="mb-2 text-sm font-semibold uppercase tracking-wide text-stone-500">Tipo de cultivo</legend>
        <div class="flex flex-wrap gap-2" id="tipo-group">
          {tipos.map((t) => (
            <button type="button" data-tipo={t.val} class="tipo-btn rounded-full border border-stone-200 px-3 py-1.5 text-sm text-stone-700 transition hover:border-(--color-hoja)" aria-pressed={t.val === 'todos' ? 'true' : 'false'}>{t.label}</button>
          ))}
        </div>
      </fieldset>

      <div class="mt-5 flex flex-wrap gap-2">
        <button type="button" id="facil-btn" class="filtro-toggle rounded-full border border-stone-200 px-3 py-1.5 text-sm text-stone-700 transition hover:border-(--color-hoja)" aria-pressed="false">🌱 Solo fáciles</button>
        <button type="button" id="rapido-btn" class="filtro-toggle rounded-full border border-stone-200 px-3 py-1.5 text-sm text-stone-700 transition hover:border-(--color-hoja)" aria-pressed="false">⚡ Cosecha rápida</button>
      </div>
    </fieldset>
  </div>

  <div class="mt-8">
    <p id="resultado-contador" class="mb-4 text-sm font-semibold text-(--color-hoja-oscuro)"></p>
    <ul id="resultado-lista" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></ul>
    <p id="resultado-vacio" class="hidden rounded-2xl bg-(--color-crema-oscuro) p-6 text-center text-stone-600">
      Con esos filtros no hay cultivos recomendados. Prueba a quitar alguno o a cambiar el mes, o consulta
      nuestro <a href={withBase('/articulos/calendario-siembra-completo-mes-a-mes/')} class="text-(--color-tierra) underline">calendario de siembra completo</a>.
    </p>
  </div>

  <div class="mt-10 rounded-2xl border border-(--color-mostaza)/40 bg-white p-5 text-sm text-stone-600 sm:p-6">
    <p>
      <strong>Sobre la compatibilidad:</strong> en cada resultado te decimos con qué cultivos se
      lleva bien y cuáles conviene no juntar (los de su misma familia agotan lo mismo y comparten
      plagas). Amplía el tema en nuestra guía de
      <a href={withBase('/articulos/asociacion-cultivos-maceta-balcon/')} class="font-medium text-(--color-tierra) hover:underline">asociación de cultivos en maceta</a>.
    </p>
    <p class="mt-2">
      Para empezar con buen pie, no te pierdas <a href={withBase('/articulos/como-empezar-huerto-urbano-balcon/')} class="font-medium text-(--color-tierra) hover:underline">cómo montar tu primer huerto de balcón</a>
      y <a href={withBase('/articulos/mejor-sustrato-huerto-urbano-maceta/')} class="font-medium text-(--color-tierra) hover:underline">qué sustrato elegir</a>.
    </p>
  </div>

  <section class="mt-14 max-w-3xl">
    <h2 class="font-(--font-display) text-2xl font-semibold text-(--color-hoja-oscuro)">
      Cómo saber cuánta luz tiene tu balcón
    </h2>
    <p class="mt-3 text-stone-700">
      Es el dato que más condiciona lo que puedes cultivar. No te fíes de la sensación de "claridad":
      lo que importa son las <strong>horas de sol directo</strong> que reciben las macetas. Guíate por la orientación:
    </p>
    <ul class="mt-4 space-y-2 text-stone-700">
      <li><strong>☀️ Mucho sol (sur):</strong> 6 horas o más de sol directo. Va todo, incluidas las hortalizas de fruto (tomate, pimiento) y los frutales.</li>
      <li><strong>⛅ Media sombra (este u oeste):</strong> sol de media jornada. Perfecto para hojas, muchas aromáticas, fresas y raíces.</li>
      <li><strong>🌥️ Sombra (norte o patios):</strong> poca o nada de luz directa. Apuesta por lechuga, espinaca, acelga, rúcula y aromáticas de hoja.</li>
    </ul>
    <p class="mt-4 text-stone-700">
      Si no lo tienes claro, obsérvalo un día despejado a distintas horas. Lo vemos en detalle en{' '}
      <a href={withBase('/articulos/cuantas-horas-sol-tiene-tu-balcon/')} class="font-medium text-(--color-tierra) hover:underline">cuántas horas de sol tiene tu balcón</a>{' '}
      y en <a href={withBase('/articulos/hortalizas-que-crecen-a-la-sombra/')} class="font-medium text-(--color-tierra) hover:underline">qué plantar si tu balcón tiene poca luz</a>.
    </p>

    <h2 class="mt-10 font-(--font-display) text-2xl font-semibold text-(--color-hoja-oscuro)">
      Cómo usar la calculadora
    </h2>
    <ol class="mt-3 list-decimal space-y-2 pl-5 text-stone-700">
      <li>Elige <strong>cuánta luz</strong> recibe tu balcón y el <strong>mes</strong> en el que estás.</li>
      <li>Afina con los filtros por <strong>tipo</strong> (hojas, raíces, aromáticas…), o marca <strong>fáciles</strong> o de <strong>cosecha rápida</strong> si empiezas.</li>
      <li>En cada resultado verás los <strong>días hasta la cosecha</strong>, con qué se <strong>lleva bien</strong> y qué conviene <strong>evitar</strong>, y un enlace a su <strong>guía completa</strong>.</li>
    </ol>

    <h2 class="mt-10 font-(--font-display) text-2xl font-semibold text-(--color-hoja-oscuro)">
      Preguntas frecuentes
    </h2>
    <div class="mt-4 space-y-3">
      {faq.map((f) => (
        <details class="group rounded-xl bg-white p-4 shadow-sm ring-1 ring-black/5">
          <summary class="cursor-pointer font-semibold text-stone-900 marker:text-(--color-mostaza-oscuro)">
            {f.pregunta}
          </summary>
          <p class="mt-2 text-stone-700">{f.respuesta}</p>
        </details>
      ))}
    </div>
  </section>

  <script type="application/json" id="datos-cultivos" set:html={JSON.stringify(datos)} />
  <script is:inline>
    const datos = JSON.parse(document.getElementById('datos-cultivos').textContent);
    const lista = document.getElementById('resultado-lista');
    const contador = document.getElementById('resultado-contador');
    const vacio = document.getElementById('resultado-vacio');
    const mesSelect = document.getElementById('mes-select');
    const luzBtns = Array.from(document.querySelectorAll('.luz-btn'));
    const tipoBtns = Array.from(document.querySelectorAll('.tipo-btn'));
    const facilBtn = document.getElementById('facil-btn');
    const rapidoBtn = document.getElementById('rapido-btn');

    // Estado
    let luz = 3;
    let mes = parseInt(mesSelect.value, 10);
    let tipo = 'todos';
    let soloFacil = false;
    let soloRapido = false;

    function pintarSeleccionLuz() {
      luzBtns.forEach((b) => {
        const activo = parseInt(b.dataset.luz, 10) === luz;
        b.setAttribute('aria-pressed', activo ? 'true' : 'false');
        b.classList.toggle('border-(--color-hoja)', activo);
        b.classList.toggle('bg-(--color-crema)', activo);
        b.classList.toggle('ring-2', activo);
        b.classList.toggle('ring-(--color-hoja)', activo);
      });
    }

    function pintarChip(btn, activo) {
      btn.setAttribute('aria-pressed', activo ? 'true' : 'false');
      btn.classList.toggle('bg-(--color-hoja-oscuro)', activo);
      btn.classList.toggle('text-white', activo);
      btn.classList.toggle('border-(--color-hoja-oscuro)', activo);
      btn.classList.toggle('text-stone-700', !activo);
    }

    function pintarTipos() {
      tipoBtns.forEach((b) => pintarChip(b, b.dataset.tipo === tipo));
    }

    function nivel(luzCultivo) {
      return { sombra: 1, media: 2, pleno: 3 }[luzCultivo];
    }

    function render() {
      const filtrados = datos.filter((c) => {
        const cabeLuz = luz >= nivel(c.luz);
        const cabeMes = mes === 0 || c.meses.includes(mes);
        const cabeTipo = tipo === 'todos' || c.tipo === tipo;
        const cabeFacil = !soloFacil || c.facil;
        const cabeRapido = !soloRapido || (c.dias && c.dias <= 60);
        return cabeLuz && cabeMes && cabeTipo && cabeFacil && cabeRapido;
      });

      lista.innerHTML = '';
      if (filtrados.length === 0) {
        vacio.classList.remove('hidden');
        contador.textContent = '';
        return;
      }
      vacio.classList.add('hidden');
      contador.textContent = filtrados.length + (filtrados.length === 1 ? ' cultivo recomendado' : ' cultivos recomendados');

      for (const c of filtrados) {
        const li = document.createElement('li');

        const diasHtml = (c.dias && c.dias <= 120)
          ? '<span class="shrink-0 rounded-full bg-(--color-crema-oscuro) px-2 py-0.5 text-xs text-stone-600">🕒 ~' + c.dias + ' días</span>'
          : '';
        const facilHtml = c.facil
          ? '<span class="shrink-0 rounded-full bg-(--color-hoja)/15 px-2 py-0.5 text-xs font-medium text-(--color-hoja-oscuro)">🌱 Fácil</span>'
          : '';

        let compatHtml = '';
        if (c.buenas && c.buenas.length) {
          compatHtml += '<p class="mt-1 text-xs text-stone-600"><span class="font-semibold text-(--color-hoja-oscuro)">🤝 Va bien con:</span> ' + c.buenas.join(', ') + '</p>';
        }
        if (c.evitaMisma) {
          compatHtml += '<p class="mt-0.5 text-xs text-stone-500"><span class="font-semibold text-(--color-tierra)">⚠️ Evita:</span> otras ' + c.familia.toLowerCase() + '</p>';
        }

        li.innerHTML =
          '<a href="' + c.url + '" class="flex h-full flex-col gap-2 rounded-2xl bg-white p-4 shadow-md ring-1 ring-black/5 transition hover:-translate-y-1 hover:shadow-xl">' +
            '<div class="flex flex-wrap items-center gap-2">' +
              '<h3 class="mr-auto font-semibold text-stone-900">' + c.nombre + '</h3>' +
              '<span class="shrink-0 rounded-full bg-(--color-crema-oscuro) px-2 py-0.5 text-xs text-stone-600">' + (c.tipoLabel || '') + '</span>' +
              facilHtml +
            '</div>' +
            (diasHtml ? '<div class="flex flex-wrap gap-2">' + diasHtml + '</div>' : '') +
            '<p class="text-sm text-stone-600">' + c.nota + '</p>' +
            compatHtml +
            '<span class="mt-auto pt-1 text-sm font-medium text-(--color-tierra)">Ver guía →</span>' +
          '</a>';
        lista.appendChild(li);
      }
    }

    luzBtns.forEach((b) => b.addEventListener('click', () => {
      luz = parseInt(b.dataset.luz, 10);
      pintarSeleccionLuz();
      render();
    }));
    tipoBtns.forEach((b) => b.addEventListener('click', () => {
      tipo = b.dataset.tipo;
      pintarTipos();
      render();
    }));
    facilBtn.addEventListener('click', () => {
      soloFacil = !soloFacil;
      pintarChip(facilBtn, soloFacil);
      render();
    });
    rapidoBtn.addEventListener('click', () => {
      soloRapido = !soloRapido;
      pintarChip(rapidoBtn, soloRapido);
      render();
    });
    mesSelect.addEventListener('change', () => {
      mes = parseInt(mesSelect.value, 10);
      render();
    });

    pintarSeleccionLuz();
    pintarTipos();
    render();
  </script>
</BaseLayout>
