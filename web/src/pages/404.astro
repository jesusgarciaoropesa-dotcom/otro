---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categorias } from '../data/categorias';
import { withBase } from '../lib/url';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o se ha movido. Vuelve al inicio o explora las categorías del huerto urbano."
>
  <div class="flex flex-col items-center py-12 text-center sm:py-20">
    <span class="text-6xl" aria-hidden="true">🥕</span>
    <p class="mt-4 text-sm font-semibold uppercase tracking-widest text-(--color-tierra)">
      Error 404
    </p>
    <h1 class="mt-2 font-(--font-display) text-3xl font-semibold text-(--color-hoja-oscuro) sm:text-4xl">
      Esta página se ha marchitado
    </h1>
    <p class="mx-auto mt-4 max-w-md text-stone-600">
      El enlace que has seguido no existe o el artículo se ha movido. Prueba a volver al
      inicio o explora alguna de nuestras categorías.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={withBase('/')} class="btn-primary">Volver al inicio</a>
      <a href={withBase('/#categorias')} class="btn-secondary">Explorar categorías</a>
    </div>

    <ul class="mt-12 grid w-full max-w-2xl gap-3 text-left sm:grid-cols-3">
      {categorias.map((cat) => (
        <li>
          <a
            href={withBase(`/categorias/${cat.slug}/`)}
            class="flex items-center gap-2 rounded-xl bg-white px-4 py-3 text-sm font-medium text-stone-700 shadow-sm ring-1 ring-black/5 transition hover:-translate-y-0.5 hover:text-(--color-tierra) hover:shadow-md"
          >
            <span aria-hidden="true">{cat.emoji}</span>
            {cat.nombre}
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
