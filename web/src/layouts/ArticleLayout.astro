---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import ShareButtons from '../components/ShareButtons.astro';
import EquipoRecomendado from '../components/EquipoRecomendado.astro';
import SerieCultivos from '../components/SerieCultivos.astro';
import { getCategoria, getCategoriaImagen } from '../data/categorias';
import { withBase } from '../lib/url';

interface ArticuloRelacionado {
  id: string;
  data: { title: string; description: string };
  imagen?: string;
}

interface Heading {
  slug: string;
  text: string;
}

interface FaqItem {
  pregunta: string;
  respuesta: string;
}

interface Props {
  slug: string;
  title: string;
  description: string;
  categoria: string;
  intencion: 'informativa' | 'transaccional' | 'comparativa';
  pubDate: Date;
  updatedDate?: Date;
  relacionados?: ArticuloRelacionado[];
  headings?: Heading[];
  minutosLectura?: number;
  faq?: FaqItem[];
  /** Imagen propia del artículo (para OG/Twitter y JSON-LD). */
  imagen?: string;
}

const {
  slug,
  title,
  description,
  categoria,
  intencion,
  pubDate,
  updatedDate,
  relacionados = [],
  headings = [],
  minutosLectura,
  faq = [],
  imagen,
} = Astro.props;
const cat = getCategoria(categoria);
const imagenCategoria = cat ? getCategoriaImagen(cat.slug) : undefined;
// Preferimos la foto propia del artículo; si no la hay, la de la categoría.
const imagenOg = imagen ?? imagenCategoria;

const etiquetaIntencion: Record<typeof intencion, string> = {
  informativa: 'Guía informativa',
  transaccional: 'Guía de compra',
  comparativa: 'Comparativa',
};

const articleURL = new URL(withBase(`/articulos/${slug}/`), Astro.site);
const imageURL = imagenOg ? new URL(withBase(imagenOg), Astro.site) : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  ...(imageURL && { image: imageURL.toString() }),
  mainEntityOfPage: articleURL.toString(),
  author: { '@type': 'Organization', name: 'MiHuertoUrbano' },
  publisher: { '@type': 'Organization', name: 'MiHuertoUrbano' },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(withBase('/'), Astro.site).toString() },
    ...(cat
      ? [{ '@type': 'ListItem', position: 2, name: cat.nombre, item: new URL(withBase(`/categorias/${cat.slug}/`), Astro.site).toString() }]
      : []),
    { '@type': 'ListItem', position: cat ? 3 : 2, name: title, item: articleURL.toString() },
  ],
};

const faqLd =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({
          '@type': 'Question',
          name: f.pregunta,
          acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
        })),
      }
    : undefined;
---

<BaseLayout title={title} description={description} image={imagenOg}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} slot="head" />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} slot="head" />}

  {/* El estado inicial va como transform inline (no scale-x-0): en Tailwind v4
      las utilidades scale-* usan la propiedad CSS `scale`, que se compone con
      el `transform` que actualiza el script y dejaría la barra siempre a 0. */}
  <div
    id="reading-progress"
    aria-hidden="true"
    style="transform: scaleX(0)"
    class="fixed inset-x-0 top-0 z-50 h-1 origin-left bg-gradient-to-r from-(--color-mostaza) to-(--color-tierra)"
  />

  <nav class="mb-4 text-sm text-stone-600" aria-label="breadcrumb">
    <a href={withBase('/')} class="hover:underline">Inicio</a>
    <span class="mx-1">/</span>
    {cat && (
      <a href={withBase(`/categorias/${cat.slug}/`)} class="hover:underline">{cat.nombre}</a>
    )}
    <span class="mx-1">/</span>
    <span class="text-stone-700">{title}</span>
  </nav>

  {cat && (
    <header class="relative left-1/2 mb-8 w-screen -translate-x-1/2 overflow-hidden">
      <div class="relative h-56 sm:h-64">
        <img
          src={withBase(getCategoriaImagen(cat.slug))}
          alt=""
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-transparent" />
        <div class="absolute inset-x-0 bottom-0">
          <div class="mx-auto max-w-5xl px-4 pb-6">
            <span class="inline-block rounded-full bg-(--color-mostaza) px-3 py-1 text-xs font-semibold text-(--color-hoja-oscuro)">
              {etiquetaIntencion[intencion]}
            </span>
            <h1 class="mt-3 font-(--font-display) text-3xl font-semibold text-white drop-shadow-sm sm:text-4xl">
              {title}
            </h1>
            <p class="mt-2 text-sm text-white/80">
              Publicado el {pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
              {updatedDate && (
                <> · Actualizado el {updatedDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}</>
              )}
              {minutosLectura && <> · {minutosLectura} min de lectura</>}
            </p>
          </div>
        </div>
      </div>
    </header>
  )}

  <div class="mb-8">
    <ShareButtons url={articleURL.toString()} title={title} image={imageURL?.toString()} />
  </div>

  {headings.length >= 3 && (
    <nav
      aria-label="Índice de contenidos"
      class="mb-8 rounded-2xl bg-white p-5 shadow-md ring-1 ring-black/5 sm:p-6"
    >
      <h2 class="font-(--font-display) text-lg font-semibold text-(--color-hoja-oscuro)">
        En este artículo
      </h2>
      <ol class="mt-3 grid gap-x-8 gap-y-1.5 text-sm sm:grid-cols-2">
        {headings.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class="flex items-baseline gap-2 text-stone-700 transition hover:text-(--color-tierra) hover:underline"
            >
              <span aria-hidden="true" class="text-(--color-mostaza-oscuro)">›</span>
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )}

  <article class="prose prose-stone max-w-none prose-headings:scroll-mt-24 prose-headings:font-(--font-display) prose-headings:text-(--color-hoja-oscuro) prose-a:text-(--color-tierra) prose-a:no-underline hover:prose-a:underline">
    <AdSlot adId="article-top" label="Publicidad" />

    <slot />

    {faq.length > 0 && (
      <section aria-labelledby="faq-heading">
        <h2 id="faq-heading">Preguntas frecuentes</h2>
        {faq.map((f) => (
          <details class="group not-prose mb-3 rounded-xl bg-white p-4 shadow-sm ring-1 ring-black/5">
            <summary class="cursor-pointer font-semibold text-stone-900 marker:text-(--color-mostaza-oscuro)">
              {f.pregunta}
            </summary>
            <p class="mt-2 text-stone-700">{f.respuesta}</p>
          </details>
        ))}
      </section>
    )}

    <AdSlot adId="article-bottom" label="Publicidad" />
  </article>

  <SerieCultivos slugActual={slug} />

  <EquipoRecomendado categoria={categoria} slugActual={slug} />

  {relacionados.length > 0 && (
    <aside class="mt-12 border-t border-stone-200 pt-8">
      <h2 class="font-(--font-display) text-xl font-semibold text-(--color-hoja-oscuro)">
        También te puede interesar
      </h2>
      <ul class="mt-4 grid gap-6 sm:grid-cols-3">
        {relacionados.map((a) => (
          <li>
            <a
              href={withBase(`/articulos/${a.id}/`)}
              class="flex h-full flex-col gap-2 rounded-2xl bg-white p-4 shadow-md ring-1 ring-black/5 transition hover:-translate-y-1 hover:shadow-xl"
            >
              {(a.imagen ?? imagenCategoria) && (
                <img
                  src={withBase(a.imagen ?? imagenCategoria!)}
                  alt=""
                  loading="lazy"
                  class="h-28 w-full rounded-xl object-cover"
                />
              )}
              <h3 class="font-semibold text-stone-900">{a.data.title}</h3>
              <p class="text-sm text-stone-600">{a.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )}

  <button
    id="back-to-top"
    type="button"
    aria-label="Volver arriba"
    class="fixed bottom-6 right-6 z-40 hidden h-11 w-11 items-center justify-center rounded-full bg-(--color-hoja-oscuro) text-white shadow-lg ring-1 ring-black/10 transition hover:-translate-y-0.5 hover:bg-(--color-hoja)"
  >
    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-5 w-5">
      <path fill-rule="evenodd" d="M10 17a.75.75 0 01-.75-.75V5.612L5.29 9.77a.75.75 0 01-1.08-1.04l5.25-5.5a.75.75 0 011.08 0l5.25 5.5a.75.75 0 11-1.08 1.04l-3.96-4.158V16.25A.75.75 0 0110 17z" clip-rule="evenodd" />
    </svg>
  </button>

  <script>
    // Barra de progreso de lectura + botón "volver arriba" a partir de una pantalla de scroll.
    const progress = document.getElementById('reading-progress');
    const backToTop = document.getElementById('back-to-top');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function onScroll() {
      const total = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = total > 0 ? Math.min(window.scrollY / total, 1) : 0;
      if (progress) progress.style.transform = `scaleX(${ratio})`;
      if (backToTop) {
        backToTop.classList.toggle('hidden', window.scrollY < window.innerHeight);
        backToTop.classList.toggle('flex', window.scrollY >= window.innerHeight);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    backToTop?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    });
  </script>
</BaseLayout>
