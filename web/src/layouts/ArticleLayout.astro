---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { getCategoria } from '../data/categorias';

interface Props {
  title: string;
  description: string;
  categoria: string;
  intencion: 'informativa' | 'transaccional' | 'comparativa';
  pubDate: Date;
  updatedDate?: Date;
}

const { title, description, categoria, intencion, pubDate, updatedDate } = Astro.props;
const cat = getCategoria(categoria);

const etiquetaIntencion: Record<typeof intencion, string> = {
  informativa: 'Guía informativa',
  transaccional: 'Guía de compra',
  comparativa: 'Comparativa',
};
---

<BaseLayout title={title} description={description}>
  <nav class="mb-4 text-sm text-stone-500" aria-label="breadcrumb">
    <a href="/" class="hover:underline">Inicio</a>
    <span class="mx-1">/</span>
    {cat && (
      <a href={`/categorias/${cat.slug}/`} class="hover:underline">{cat.nombre}</a>
    )}
    <span class="mx-1">/</span>
    <span class="text-stone-700">{title}</span>
  </nav>

  <article class="prose prose-stone max-w-none prose-headings:text-[--color-hoja-oscuro] prose-a:text-[--color-hoja]">
    <header class="mb-4 not-prose">
      <span class="inline-block rounded-full bg-[--color-hoja]/10 px-3 py-1 text-xs font-medium text-[--color-hoja-oscuro]">
        {etiquetaIntencion[intencion]}
      </span>
      <h1 class="mt-3 text-3xl font-bold text-stone-900">{title}</h1>
      <p class="mt-2 text-sm text-stone-500">
        Publicado el {pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
        {updatedDate && (
          <> · Actualizado el {updatedDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}</>
        )}
      </p>
    </header>

    <AdSlot adId="article-top" label="Publicidad" />

    <slot />

    <AdSlot adId="article-bottom" label="Publicidad" />
  </article>
</BaseLayout>
