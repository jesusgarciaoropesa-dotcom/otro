---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/images/hero-huerto.jpg' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(withBase(image), Astro.site);

// Google trunca los <title> a partir de ~60 caracteres: para títulos de
// artículo ya largos por sí mismos, añadir la marca los empujaría fuera
// del fragmento visible en resultados de búsqueda, así que solo se añade
// cuando cabe con holgura. El nombre del sitio sigue presente en todas las
// páginas vía og:site_name, para redes sociales y paneles de marca.
const pageTitle = `${title} · MiHuertoUrbano`.length <= 60 ? `${title} · MiHuertoUrbano` : title;
---

<!doctype html>
<html lang="es">
  <head>
    <script is:inline>
      // Google Consent Mode v2: por defecto se deniega todo lo no esencial
      // hasta que el usuario elija en el banner de cookies. Debe ejecutarse
      // ANTES de cualquier script de AdSense/Analytics que se añada después.
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
      });
      gtag('js', new Date());
      gtag('config', 'G-RTVQE0GBGV');
      window.gtagConsent = gtag;
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RTVQE0GBGV"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <meta name="theme-color" content="#24401f" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="MiHuertoUrbano" href={withBase('/rss.xml')} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MiHuertoUrbano" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="p:domain_verify" content="1af9b9d6283a17e87c0bb0857993a2c7" />
    <slot name="head" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5086488459276769" crossorigin="anonymous"></script>
  </head>
  <body class="flex min-h-screen flex-col overflow-x-hidden">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-(--color-tierra) focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      Saltar al contenido principal
    </a>
    <Header />
    <main id="main-content" data-pagefind-body class="mx-auto w-full max-w-5xl flex-1 px-4 py-10 sm:py-12">
      <slot />
    </main>
    <Footer />
    <CookieBanner />

    <script>
      // Revela con fade+slide los elementos .reveal según entran en pantalla.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll<HTMLElement>('.reveal');

      if (reduceMotion || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -60px 0px', threshold: 0.1 }
        );
        items.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
