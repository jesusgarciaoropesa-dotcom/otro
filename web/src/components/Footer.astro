---
import { categorias } from '../data/categorias';
import { withBase } from '../lib/url';
---

<footer class="mt-20 bg-(--color-hoja-oscuro) text-(--color-crema)/80">
  <div class="mx-auto max-w-5xl px-4 py-12">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <a href={withBase('/')} class="flex items-center gap-3 font-(--font-display) text-lg font-semibold text-white">
          <img src={withBase('/images/logo-full.png')} alt="MiHuertoUrbano" width="48" height="48" class="h-12 w-12" />
          MiHuertoUrbano
        </a>
        <p class="mt-3 max-w-xs text-sm">
          Guías prácticas para cultivar hortalizas, aromáticas y frutales en balcones
          y terrazas pequeñas, sin necesidad de jardín.
        </p>
        <div class="mt-4 flex items-center gap-3">
          <a
            href="https://www.pinterest.com/MiHuertoUrbanoxyz/"
            target="_blank"
            rel="noopener"
            aria-label="MiHuertoUrbano en Pinterest"
            class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-4.5 w-4.5">
              <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.024 0 1.518.769 1.518 1.69 0 1.03-.655 2.567-.992 3.992-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.136.893 2.738a.36.36 0 01.083.345c-.091.378-.293 1.194-.333 1.361-.052.218-.172.264-.397.159-1.481-.69-2.407-2.856-2.407-4.598 0-3.744 2.72-7.183 7.842-7.183 4.117 0 7.317 2.933 7.317 6.851 0 4.087-2.577 7.376-6.153 7.376-1.202 0-2.331-.624-2.717-1.362l-.739 2.819c-.268 1.031-.991 2.322-1.475 3.109.111.034.223.062.336.088A12 12 0 1012 0z"/>
            </svg>
          </a>
          <a
            href="https://www.instagram.com/mihuertourbano.xyz/"
            target="_blank"
            rel="noopener"
            aria-label="MiHuertoUrbano en Instagram"
            class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-4.5 w-4.5">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6 6 0 100 12 6 6 0 000-12zm0 9.838a3.838 3.838 0 110-7.676 3.838 3.838 0 010 7.676zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-white">Categorías</h3>
        <ul class="mt-3 space-y-2 text-sm">
          {categorias.map((cat) => (
            <li>
              <a href={withBase(`/categorias/${cat.slug}/`)} class="transition hover:text-white hover:underline">
                {cat.nombre}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-white">Sobre el sitio</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={withBase('/articulos/')} class="transition hover:text-white hover:underline">Todos los artículos</a></li>
          <li><a href={withBase('/que-le-pasa-a-mi-planta/')} class="transition hover:text-white hover:underline">¿Qué le pasa a mi planta?</a></li>
          <li><a href={withBase('/que-plantar-en-tu-balcon/')} class="transition hover:text-white hover:underline">Calculadora de qué plantar</a></li>
          <li><a href={withBase('/sobre-nosotros/')} class="transition hover:text-white hover:underline">Sobre nosotros</a></li>
          <li><a href={withBase('/contacto/')} class="transition hover:text-white hover:underline">Contacto</a></li>
          <li><a href={withBase('/politica-de-privacidad/')} class="transition hover:text-white hover:underline">Privacidad</a></li>
          <li><a href={withBase('/politica-de-cookies/')} class="transition hover:text-white hover:underline">Cookies</a></li>
          <li><a href={withBase('/rss.xml')} class="transition hover:text-white hover:underline">RSS</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-(--color-crema)/60 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {new Date().getFullYear()} MiHuertoUrbano. Todos los derechos reservados.</p>
      <p>
        Este sitio contiene enlaces de afiliados. Podemos recibir una comisión por compras
        realizadas a través de nuestros enlaces, sin coste adicional para ti.
      </p>
    </div>
  </div>
</footer>
