---
// ANUNCIOS EN PAUSA (sept. 2026).
// AdSense marcó el sitio como "contenido de poco valor". Mientras reforzamos
// el contenido y crece el tráfico, no mostramos anuncios: un sitio joven con
// poca visita y anuncios puntúa peor en la revisión, y el ingreso ahora es ~0.
// Para reactivarlos: restaurar el bloque <ins class="adsbygoogle"> de abajo y
// el cargador de AdSense en BaseLayout.astro. Se mantiene el componente y sus
// props para no tocar las páginas que lo usan.
interface Props {
  adId: string;
  label?: string;
  class?: string;
}
// Props aceptadas pero no usadas mientras los anuncios están en pausa.
const _props = Astro.props as Props;
void _props;
---
{/* Sin salida: los anuncios están en pausa. */}
