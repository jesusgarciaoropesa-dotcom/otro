---
import { categorias } from '../data/categorias';
---

<header class="border-b border-stone-200 bg-white">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-4">
    <a href="/" class="flex items-center gap-2 text-xl font-bold text-[--color-hoja-oscuro]">
      <span aria-hidden="true">🌿</span>
      Mi Balcón Verde
    </a>
    <nav class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
      {categorias.map((cat) => (
        <a
          href={`/categorias/${cat.slug}/`}
          class="whitespace-nowrap text-stone-600 hover:text-[--color-hoja-oscuro] hover:underline"
        >
          {cat.nombre}
        </a>
      ))}
    </nav>
  </div>
</header>
